{
  "name": "ayaw-kalimti",
  "version": "0.0.0",
  "private": true,
  "description": "Ayaw Kalimti production-track Android MVP workspace.",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "corepack npm@11.12.1 run format:check && corepack npm@11.12.1 run lint && corepack npm@11.12.1 run typecheck && corepack npm@11.12.1 run test && corepack npm@11.12.1 run check:generated && corepack npm@11.12.1 run check:dependencies",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "local:reset": "node scripts/local-stack.cjs reset",
    "local:start": "node scripts/local-stack.cjs start",
    "local:stop": "node scripts/local-stack.cjs stop",
    "local:verify": "node scripts/local-stack.cjs verify",
    "typecheck": "tsc --noEmit --pretty false --project tsconfig.json",
    "test": "jest --runInBand --passWithNoTests",
    "test:local-integration": "node scripts/local-stack.cjs integration",
    "test:preview": "node scripts/preview-tests.cjs",
    "check:generated": "node scripts/check-generated.cjs",
    "check:dependencies": "corepack npm@11.12.1 ls --all --silent"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.13",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
